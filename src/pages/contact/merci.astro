---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import { site } from '../../lib/site';
---
<BaseLayout
  title="Demande envoyée — FlashUp"
  description="Votre demande de devis a bien été transmise à FlashUp."
  noindex
>
  <section class="section thanks">
    <div class="container container--narrow">
      <div class="form-success">
        <span class="form-success__icon"><Icon name="circle-check" /></span>
        <h1>Merci, votre demande a bien été envoyée.</h1>
        <p>Je l'étudie personnellement et je reviens vers vous rapidement avec une proposition adaptée à votre activité. Pour toute urgence, appelez-moi ou écrivez-moi sur WhatsApp.</p>
        <div class="btn-row">
          <a href={site.phoneHref} class="btn btn--ghost"><Icon name="phone" /> {site.phone}</a>
          <a href={site.whatsappHref} class="btn btn--ghost btn--whatsapp" target="_blank" rel="noopener"><BrandIcon name="whatsapp" /> WhatsApp</a>
          <a href="/realisations/" class="btn btn--primary">Voir mes réalisations <Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks { padding-top: calc(var(--header-h) + 64px); min-height: 70vh; }
  .thanks h1 { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem); }
</style>
