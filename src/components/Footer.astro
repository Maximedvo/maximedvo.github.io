---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-flashup.png';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { site } from '../lib/site';
import { getOffres, offreUrl } from '../lib/offres';

const offres = await getOffres();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label="FlashUp — accueil">
          <Image src={logo} alt="FlashUp — Esthétique automobile" width={220} densities={[1, 2]} />
        </a>
        <p>Préparateur esthétique automobile indépendant. Nettoyage, detailing et rénovation, pour les particuliers et les professionnels.</p>
        <p class="site-footer__zone"><Icon name="map-pin" size={16} /> {site.zone}.</p>
      </div>

      <nav class="site-footer__col" aria-label="Solutions">
        <p class="site-footer__title">Solutions</p>
        <ul>
          {offres.map((o) => <li><a href={offreUrl(o.id)}>{o.data.cible}</a></li>)}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Plan du site">
        <p class="site-footer__title">FlashUp</p>
        <ul>
          <li><a href="/">Accueil</a></li>
          <li><a href="/realisations/">Réalisations</a></li>
          <li><a href="/avis/">Avis clients</a></li>
          <li><a href="/contact/">Demande de devis</a></li>
        </ul>
      </nav>

      <div class="site-footer__col">
        <p class="site-footer__title">Contact</p>
        <ul class="site-footer__contact">
          <li><a href={site.phoneHref}><Icon name="phone" size={16} /> {site.phone}</a></li>
          <li><a href={site.whatsappHref} target="_blank" rel="noopener"><BrandIcon name="whatsapp" size={16} /> WhatsApp</a></li>
          <li><a href={site.emailHref}><Icon name="mail" size={16} /> {site.email}</a></li>
          <li><a href={site.instagramHref} target="_blank" rel="noopener"><BrandIcon name="instagram" size={16} /> @{site.instagram}</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        © {year} {site.legal.denomination || site.name}
        {site.legal.bce ? <span> · BCE {site.legal.bce}</span> : site.showPlaceholders ? <span> · <span class="ph-text">N° d'entreprise à compléter</span></span> : null}
      </p>
      <ul>
        <li><a href="/mentions-legales/">Mentions légales</a></li>
        <li><a href="/confidentialite/">Confidentialité</a></li>
        <li><a href="/cookies/">Cookies</a></li>
        {site.analytics.ga4 && <li><button type="button" class="site-footer__linkbtn" data-consent-open>Gérer les cookies</button></li>}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #050506;
    border-top: 1px solid var(--c-line);
    padding-top: clamp(56px, 7vw, 88px);
    padding-bottom: calc(28px + env(safe-area-inset-bottom));
    font-size: 0.95rem;
  }
  .site-footer__top {
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr;
    padding-bottom: 48px;
  }
  @media (min-width: 720px) { .site-footer__top { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .site-footer__top { grid-template-columns: 1.5fr 1fr 0.8fr 1.1fr; gap: 48px; } }
  .site-footer__brand { display: grid; gap: 18px; align-content: start; }
  .site-footer__brand img { width: 220px; height: auto; }
  .site-footer__brand p { color: var(--c-text-2); max-width: 40ch; margin: 0; }
  .site-footer__zone { display: flex; gap: 8px; align-items: flex-start; font-size: 0.9rem; }
  .site-footer__zone svg { color: var(--c-orange); margin-top: 4px; }
  .site-footer__title {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-white);
    margin-bottom: 18px;
  }
  .site-footer__col ul { list-style: none; display: grid; gap: 12px; }
  .site-footer__col a { color: var(--c-text-2); transition: color 0.2s; }
  .site-footer__col a:hover { color: var(--c-orange); }
  .site-footer__contact a { display: inline-flex; align-items: center; gap: 10px; word-break: break-word; }
  .site-footer__contact svg { color: var(--c-orange); }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--c-line);
    color: var(--c-text-3);
    font-size: 0.85rem;
  }
  .site-footer__bottom p { margin: 0; }
  .site-footer__bottom ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .site-footer__bottom a:hover,
  .site-footer__linkbtn:hover { color: var(--c-orange); }
  .site-footer__linkbtn { background: none; border: 0; padding: 0; color: inherit; font-size: inherit; }
</style>
