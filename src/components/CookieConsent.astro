---
/**
 * Bandeau de consentement aux cookies.
 * Il n'apparaît QUE si un identifiant Google Analytics 4 est renseigné
 * (sans outil de mesure, le site ne dépose aucun cookie non essentiel).
 * Google Analytics n'est chargé qu'après acceptation explicite.
 */
import { site } from '../lib/site';
const ga4 = site.analytics.ga4;
---
{ga4 && (
  <div class="consent" data-consent data-ga={ga4} hidden>
    <div class="consent__box" role="dialog" aria-modal="false" aria-labelledby="consent-title" aria-describedby="consent-text">
      <p class="consent__title" id="consent-title">Vos préférences de cookies</p>
      <p class="consent__text" id="consent-text">
        Ce site utilise des cookies de mesure d'audience (Google Analytics) pour comprendre l'utilisation du site et l'améliorer.
        Ils ne sont déposés qu'avec votre accord. <a href="/cookies/">En savoir plus</a>
      </p>

      <div class="consent__prefs" data-consent-prefs hidden>
        <label class="consent__row">
          <span>
            <strong>Cookies essentiels</strong>
            <small>Nécessaires au fonctionnement du site. Toujours actifs.</small>
          </span>
          <input type="checkbox" checked disabled />
        </label>
        <label class="consent__row">
          <span>
            <strong>Mesure d'audience</strong>
            <small>Google Analytics 4 : statistiques de visite anonymisées.</small>
          </span>
          <input type="checkbox" data-consent-analytics />
        </label>
      </div>

      <div class="consent__actions">
        <button type="button" class="btn btn--ghost btn--sm" data-consent-reject>Tout refuser</button>
        <button type="button" class="btn btn--ghost btn--sm" data-consent-customize>Personnaliser</button>
        <button type="button" class="btn btn--ghost btn--sm" data-consent-save hidden>Enregistrer</button>
        <button type="button" class="btn btn--primary btn--sm" data-consent-accept>Tout accepter</button>
      </div>
    </div>
  </div>
)}

<script>
  import { initConsent } from '../scripts/consent';
  initConsent();
</script>

<style>
  .consent {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 150;
    display: flex;
    justify-content: flex-start;
    pointer-events: none;
  }
  .consent__box {
    pointer-events: auto;
    width: 100%;
    max-width: 460px;
    padding: 22px;
    background: var(--c-surface);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    display: grid;
    gap: 14px;
  }
  .consent__title { font-weight: 700; color: var(--c-white); margin: 0; }
  .consent__text { font-size: 0.9rem; color: var(--c-text-2); line-height: 1.55; margin: 0; }
  .consent__text a { text-decoration: underline; text-underline-offset: 2px; color: var(--c-white); }
  .consent__prefs { display: grid; gap: 10px; }
  .consent__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 14px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .consent__row strong { display: block; font-size: 0.9rem; color: var(--c-white); }
  .consent__row small { display: block; font-size: 0.8rem; color: var(--c-text-3); line-height: 1.4; }
  .consent__row input { width: 20px; height: 20px; accent-color: var(--c-orange); flex: none; }
  .consent__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .consent__actions .btn--primary { grid-column: 1 / -1; }
  @media (min-width: 480px) {
    .consent__actions { grid-template-columns: repeat(3, auto); justify-content: start; }
    .consent__actions .btn--primary { grid-column: auto; }
  }
</style>
