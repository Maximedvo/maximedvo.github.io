---
/** Affiche une note sur 5 (avec demi-étoile). */
interface Props { rating: number; size?: 'md' | 'lg'; }
const { rating, size = 'md' } = Astro.props;
const star = 'M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z';
const uid = Math.random().toString(36).slice(2, 8);
const fills = [1, 2, 3, 4, 5].map((i) => {
  const diff = rating - (i - 1);
  return diff >= 0.75 ? 'full' : diff >= 0.25 ? 'half' : 'empty';
});
const label = `${rating.toLocaleString('fr-BE')} sur 5`;
---
<span class:list={['stars', size === 'lg' && 'stars--lg']} role="img" aria-label={label}>
  {fills.map((f, i) => (
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      {f === 'half' && <defs><clipPath id={`h-${uid}-${i}`}><rect width="12" height="24" /></clipPath></defs>}
      <path d={star} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" class={f === 'empty' ? 'star--empty' : ''} />
      {f === 'full' && <path d={star} fill="currentColor" />}
      {f === 'half' && <path d={star} fill="currentColor" clip-path={`url(#h-${uid}-${i})`} />}
    </svg>
  ))}
</span>
