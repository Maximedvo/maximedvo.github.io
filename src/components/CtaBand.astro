---
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  text?: string;
  cta?: string;
  href?: string;
}
const {
  title = 'Des véhicules à préparer ? Parlons-en.',
  text = 'Décrivez votre activité et votre volume : je vous propose une solution adaptée, ponctuelle ou régulière.',
  cta = 'Demander un devis',
  href = '/contact/',
} = Astro.props;
---
<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="container">
    <div class="cta-band__box" data-reveal>
      <div class="cta-band__text">
        <h2 id="cta-band-title">{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta-band__actions">
        <a href={href} class="btn btn--primary btn--lg">{cta} <Icon name="arrow-right" /></a>
        <div class="cta-band__quick">
          <a href={site.phoneHref} class="btn btn--ghost"><Icon name="phone" /> {site.phone}</a>
          <a href={site.whatsappHref} class="btn btn--ghost btn--whatsapp" target="_blank" rel="noopener"><BrandIcon name="whatsapp" /> WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: clamp(48px, 7vw, 96px); }
  .cta-band__box {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 32px;
    padding: clamp(28px, 5vw, 64px);
    border: 1px solid rgba(240, 118, 12, 0.3);
    border-radius: 14px;
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(240, 118, 12, 0.22), transparent 55%),
      linear-gradient(180deg, #16120e, #0f0f10);
  }
  .cta-band__box::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--c-orange), transparent);
    opacity: 0.6;
  }
  @media (min-width: 980px) {
    .cta-band__box { grid-template-columns: 1.3fr auto; align-items: center; gap: 56px; }
  }
  .cta-band h2 { font-size: clamp(1.7rem, 1.2rem + 2vw, 2.6rem); }
  .cta-band p { color: var(--c-text-2); margin-top: 14px; max-width: 52ch; }
  .cta-band__actions { display: grid; gap: 10px; }
  .cta-band__quick { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  @media (max-width: 400px) { .cta-band__quick { grid-template-columns: 1fr; } }
</style>
