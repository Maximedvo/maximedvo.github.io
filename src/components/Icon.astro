---
/**
 * Icône vectorielle (bibliothèque Lucide, licence ISC), intégrée au moment de la compilation.
 * Liste des noms : https://lucide.dev/icons
 */
import { readFileSync, existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { createRequire } from 'node:module';

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = '', label, strokeWidth = 1.75 } = Astro.props;

// Dossier des icônes, trouvé quel que soit le dossier depuis lequel le site est lancé
const candidates: string[] = [];
try {
  candidates.push(join(dirname(createRequire(import.meta.url).resolve('lucide-static/package.json')), 'icons'));
} catch {
  /* repli ci-dessous */
}
candidates.push(join(process.cwd(), 'node_modules', 'lucide-static', 'icons'));
const dir = candidates.find((d) => existsSync(d)) ?? candidates[0];
const safe = /^[a-z0-9-]+$/.test(name) ? name : 'check';
let file = join(dir, `${safe}.svg`);
if (!existsSync(file)) {
  console.warn(`[Icon] icône inconnue : « ${name} » (remplacée par une coche)`);
  file = join(dir, 'check.svg');
}
const svg = readFileSync(file, 'utf8');
const inner = svg.slice(svg.indexOf('>', svg.indexOf('<svg')) + 1, svg.lastIndexOf('</svg>')).trim();
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', `icon-${name}`, className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
