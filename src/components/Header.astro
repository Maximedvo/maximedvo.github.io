---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-flashup-header.png';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { site } from '../lib/site';
import { getOffres, offreUrl } from '../lib/offres';

const offres = await getOffres();
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const solutionsActive = path.startsWith('/solutions/');
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="FlashUp — retour à l'accueil">
      <Image src={logo} alt="FlashUp — Esthétique automobile" height={40} densities={[1, 2, 3]} loading="eager" fetchpriority="high" />
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <ul class="nav__list">
        <li class="nav__item nav__item--dropdown" data-dropdown>
          <button class:list={['nav__link', { 'is-active': solutionsActive }]} type="button" aria-expanded="false" aria-controls="nav-solutions" data-dropdown-toggle>
            Solutions <Icon name="chevron-down" size={16} />
          </button>
          <div class="dropdown" id="nav-solutions" data-dropdown-panel>
            <ul>
              {offres.map((o) => (
                <li>
                  <a href={offreUrl(o.id)} class="dropdown__link" aria-current={path.startsWith(offreUrl(o.id)) ? 'page' : undefined}>
                    <span class="icon-box"><Icon name={o.data.icone} /></span>
                    <span>
                      <strong>{o.data.cible}</strong>
                      <small>{o.data.resumeCarte}</small>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
        <li><a href="/#qui-suis-je" class="nav__link">Qui suis-je</a></li>
        <li><a href="/realisations/" class:list={['nav__link', { 'is-active': isActive('/realisations/') }]} aria-current={isActive('/realisations/') ? 'page' : undefined}>Réalisations</a></li>
        <li><a href="/avis/" class:list={['nav__link', { 'is-active': isActive('/avis/') }]} aria-current={isActive('/avis/') ? 'page' : undefined}>Avis clients</a></li>
        <li><a href="/contact/" class:list={['nav__link', { 'is-active': isActive('/contact/') }]} aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a></li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={site.phoneHref} class="site-header__phone" aria-label={`Appeler FlashUp au ${site.phone}`}>
        <Icon name="phone" size={18} />
        <span>{site.phone}</span>
      </a>
      <a href="/contact/" class="btn btn--primary btn--sm site-header__cta">
        <span class="label-long">Demander un devis</span><span class="label-short">Devis</span>
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Ouvrir le menu" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <div class="container mobile-menu__inner">
      <p class="mobile-menu__label">Vous êtes…</p>
      <ul class="mobile-menu__offers">
        {offres.map((o) => (
          <li>
            <a href={offreUrl(o.id)}>
              <Icon name={o.data.icone} size={20} />
              <span>{o.data.cible}</span>
              <Icon name="arrow-right" size={18} />
            </a>
          </li>
        ))}
      </ul>
      <ul class="mobile-menu__links">
        <li><a href="/#qui-suis-je">Qui suis-je</a></li>
        <li><a href="/realisations/">Réalisations</a></li>
        <li><a href="/avis/">Avis clients</a></li>
        <li><a href="/contact/">Contact & devis</a></li>
      </ul>
      <div class="mobile-menu__contact">
        <a href="/contact/" class="btn btn--primary btn--lg btn--block">Demander un devis <Icon name="arrow-right" /></a>
        <div class="mobile-menu__quick">
          <a href={site.phoneHref} class="btn btn--ghost"><Icon name="phone" /> Appeler</a>
          <a href={site.whatsappHref} class="btn btn--ghost btn--whatsapp" target="_blank" rel="noopener"><BrandIcon name="whatsapp" /> WhatsApp</a>
        </div>
        <a href={site.emailHref} class="mobile-menu__email"><Icon name="mail" size={18} /> {site.email}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--header-h);
    transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease), backdrop-filter 0.35s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgba(10, 10, 11, 0.92);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom-color: var(--c-line);
  }
  .site-header.is-open { background: var(--c-bg); }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .site-header__logo { flex: none; display: block; }
  .site-header__logo img { height: 36px; width: auto; }
  @media (min-width: 1024px) { .site-header__logo img { height: 40px; } }

  .nav { margin-left: auto; display: none; }
  @media (min-width: 1024px) { .nav { display: block; } }
  .nav__list { list-style: none; display: flex; align-items: center; gap: 4px; }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 14px;
    border: 0;
    background: none;
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--c-text-2);
    border-radius: var(--radius);
    transition: color 0.2s;
    position: relative;
  }
  .nav__link:hover,
  .nav__link.is-active { color: var(--c-white); }
  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 2px;
    background: var(--c-orange);
  }
  .nav__link svg { transition: transform 0.25s var(--ease); }
  .nav__link[aria-expanded='true'] svg { transform: rotate(180deg); }

  .nav__item--dropdown { position: relative; }
  .dropdown {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    width: 440px;
    padding: 10px;
    background: var(--c-surface);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition: opacity 0.22s var(--ease), transform 0.22s var(--ease), visibility 0.22s;
  }
  .dropdown::before { content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 14px; }
  .nav__item--dropdown.is-open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  @media (hover: hover) {
    .nav__item--dropdown:hover .dropdown {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }
  }
  .dropdown ul { list-style: none; display: grid; gap: 2px; }
  .dropdown__link {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 14px;
    align-items: center;
    padding: 12px;
    border-radius: 8px;
    transition: background-color 0.2s;
  }
  .dropdown__link:hover,
  .dropdown__link[aria-current='page'] { background: rgba(255, 255, 255, 0.04); }
  .dropdown__link strong { display: block; font-size: 0.95rem; color: var(--c-white); font-weight: 600; line-height: 1.3; }
  .dropdown__link small { display: block; font-size: 0.82rem; color: var(--c-text-3); line-height: 1.4; margin-top: 2px; }

  .site-header__actions { display: flex; align-items: center; gap: 10px; margin-left: auto; }
  @media (min-width: 1024px) { .site-header__actions { margin-left: 8px; } }
  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--c-white);
    font-variant-numeric: tabular-nums;
    border-radius: var(--radius);
  }
  .site-header__phone svg { color: var(--c-orange); }
  .site-header__phone:hover { color: var(--c-orange); }
  .site-header__phone span { display: none; }
  @media (min-width: 1180px) { .site-header__phone span { display: inline; } }
  .site-header__phone { width: 42px; height: 42px; justify-content: center; border: 1px solid var(--c-line-strong); }
  @media (min-width: 1180px) { .site-header__phone { width: auto; border: 0; } }

  .label-short { display: none; }
  @media (max-width: 479px) {
    .label-long { display: none; }
    .label-short { display: inline; }
  }

  .burger {
    width: 42px;
    height: 42px;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 6px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    background: none;
  }
  .burger span { width: 18px; height: 1.5px; background: var(--c-white); transition: transform 0.3s var(--ease); }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  @media (min-width: 1024px) { .burger { display: none; } }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--c-bg);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: calc(32px + env(safe-area-inset-bottom));
  }
  @media (min-width: 1024px) { .mobile-menu { display: none !important; } }
  .mobile-menu__inner { display: grid; gap: 28px; padding-top: 24px; }
  .mobile-menu__label {
    font-size: var(--fs-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-orange);
    font-weight: 600;
    margin: 0;
  }
  .mobile-menu__offers { list-style: none; display: grid; gap: 8px; margin-top: -16px; }
  .mobile-menu__offers a {
    display: grid;
    grid-template-columns: 22px 1fr 18px;
    gap: 14px;
    align-items: center;
    padding: 16px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    font-weight: 600;
    color: var(--c-white);
    line-height: 1.3;
  }
  .mobile-menu__offers a svg:first-child { color: var(--c-orange); }
  .mobile-menu__offers a svg:last-child { color: var(--c-text-3); }
  .mobile-menu__links { list-style: none; display: grid; }
  .mobile-menu__links a {
    display: block;
    padding: 14px 0;
    font-size: 1.5rem;
    font-weight: 600;
    font-stretch: 112%;
    color: var(--c-white);
    border-bottom: 1px solid var(--c-line);
  }
  .mobile-menu__contact { display: grid; gap: 12px; }
  .mobile-menu__quick { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .mobile-menu__email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    color: var(--c-text-2);
    font-size: 0.95rem;
  }
</style>
